<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>On Case creation, maps Priority to Severity__c (High→S1, Medium→S2, Low/other→S3) and defaults Milestone_Type__c to First Response. Only runs when Severity__c is not already set so manual overrides are respected.</description>
    <label>Case – Set SLT Fields On Create</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Obsolete</status>

    <!-- ── Trigger: Before Save, Create only, Severity not yet set ── -->
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Map_Priority_To_Severity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Severity__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>

    <!-- ── Decision: Priority → Severity ── -->
    <decisions>
        <name>Map_Priority_To_Severity</name>
        <label>Map Priority to Severity</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <defaultConnector>
            <targetReference>Set_S3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other / No Priority → S3</defaultConnectorLabel>
        <rules>
            <name>Priority_High</name>
            <label>High → S1</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_S1</targetReference>
            </connector>
        </rules>
        <rules>
            <name>Priority_Medium</name>
            <label>Medium → S2</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Medium</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_S2</targetReference>
            </connector>
        </rules>
        <rules>
            <name>Priority_Low</name>
            <label>Low → S3</label>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Low</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_S3</targetReference>
            </connector>
        </rules>
    </decisions>

    <!-- ── Assignments ── -->
    <assignments>
        <name>Set_S1</name>
        <label>Set S1 – Production Down</label>
        <locationX>0</locationX>
        <locationY>240</locationY>
        <assignmentItems>
            <assignToReference>$Record.Severity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>S1</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Milestone_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>First Response</stringValue>
            </value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Set_S2</name>
        <label>Set S2 – Production Impaired</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <assignmentItems>
            <assignToReference>$Record.Severity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>S2</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Milestone_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>First Response</stringValue>
            </value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Set_S3</name>
        <label>Set S3 – Minor Issue</label>
        <locationX>352</locationX>
        <locationY>240</locationY>
        <assignmentItems>
            <assignToReference>$Record.Severity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>S3</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Milestone_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>First Response</stringValue>
            </value>
        </assignmentItems>
    </assignments>

</Flow>
