<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>When First_Response_Date__c is set on a Case, switches Milestone_Type__c to Update so the dashboard shows the correct SLT phase.</description>
    <label>Case – Switch Milestone to Update on First Response</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <!-- ── Trigger: Before Save, Update, when First_Response_Date__c just got set ── -->
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Milestone_Update</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>First_Response_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>

    <!-- ── Assignment: set Milestone_Type__c = Update ── -->
    <assignments>
        <name>Set_Milestone_Update</name>
        <label>Set Milestone Type to Update</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignmentItems>
            <assignToReference>$Record.Milestone_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Update</stringValue>
            </value>
        </assignmentItems>
    </assignments>

</Flow>
