<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>SLT Dashboard Access</label>
    <description>Read access to Case SLT custom fields and Apex controller for the SF SLT Dashboard component.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <classAccesses>
        <apexClass>SLTDashboardController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <fieldPermissions>
        <field>Case.Severity__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Milestone_Type__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.First_Response_Date__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Last_Update_Date__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.SLT_Target_Hours__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Hours_Elapsed__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Hours_Remaining__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.SLT_RAG_Status__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
</PermissionSet>
