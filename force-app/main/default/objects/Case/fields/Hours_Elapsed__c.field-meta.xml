<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Hours_Elapsed__c</fullName>
    <label>Hours Elapsed</label>
    <type>Number</type>
    <precision>10</precision>
    <scale>2</scale>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(First_Response_Date__c),
    (NOW() - CreatedDate) * 24,
    IF(ISBLANK(Last_Update_Date__c),
        (NOW() - First_Response_Date__c) * 24,
        (NOW() - Last_Update_Date__c) * 24
    )
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
</CustomField>
